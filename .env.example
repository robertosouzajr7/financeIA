# FinanceIA - Environment Variables

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=3000
ENABLE_SCHEDULER=true

# ===== DATABASE =====
DATABASE_URL="file:./dev.db"
# Para produção, use PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/financeia?schema=public"

# ===== JWT AUTHENTICATION =====
JWT_SECRET=your-secret-key-change-this-in-production

# ===== STRIPE (PAYMENTS) =====
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID_BASIC=price_xxxxx
STRIPE_PRICE_ID_PRO=price_xxxxx

# ===== WHATSAPP (100% NATIVE - BAILEYS) =====
# O FinanceIA usa Baileys nativamente - SEM dependências externas!
# As credenciais do WhatsApp são salvas em /server/.auth/{instance_name}/
# Não é necessário configurar nenhuma variável de ambiente para WhatsApp
# Simplesmente crie uma instância via API e escaneie o QR code!

# ===== EMAIL SERVICE =====
# Option 1: Resend
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@financeia.com

# Option 2: Generic SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===== AI / LLM =====
# Choose one provider (or configure multiple as fallback)
LLM_PROVIDER=gemini  # Options: openai, anthropic, gemini

# OpenAI
# OPENAI_API_KEY=sk-xxxxx

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Gemini (RECOMENDADO - gratuito até 60 req/min)
# Obtenha sua chave grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxx

# Funcionalidades do Gemini:
# - Conversas de texto (gemini-flash-latest)
# - Transcrição de áudio via WhatsApp (gemini-1.5-flash)
# - Análise de imagens (gemini-1.5-flash)
# - Leitura de PDFs (extração de texto)

# ===== CLAUDE API (for receipt processing - PREMIUM FEATURE) =====
# Note: This is different from ANTHROPIC_API_KEY
# Used specifically for OCR/image processing
# CLAUDE_API_KEY=sk-ant-xxxxx

# ===== REDIS (OPTIONAL - for production) =====
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ===== FILE STORAGE (OPTIONAL) =====
# AWS S3
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=financeia-uploads

# Cloudinary
# CLOUDINARY_CLOUD_NAME=xxxxx
# CLOUDINARY_API_KEY=xxxxx
# CLOUDINARY_API_SECRET=xxxxx

# ===== ERROR TRACKING (OPTIONAL) =====
# Sentry
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_ENVIRONMENT=development

# ===== MONITORING (OPTIONAL) =====
# Application Performance Monitoring
# NEW_RELIC_LICENSE_KEY=xxxxx
# NEW_RELIC_APP_NAME=FinanceIA

# ===== CORS =====
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Deixe vazio para permitir todas as origens (não recomendado em produção)

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== SECURITY =====
# Helmet CSP
# CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'

# ===== LOGGING =====
LOG_LEVEL=info  # Options: error, warn, info, debug, verbose
LOG_FORMAT=json  # Options: json, simple

# ===== OPEN BANKING (FUTURE) =====
# Pluggy
# PLUGGY_CLIENT_ID=xxxxx
# PLUGGY_CLIENT_SECRET=xxxxx

# Belvo
# BELVO_SECRET_ID=xxxxx
# BELVO_SECRET_PASSWORD=xxxxx

# ===== WEBHOOKS =====
# Secret for validating incoming webhooks
WEBHOOK_SECRET=change-this-secret-in-production

# ===== FEATURE FLAGS =====
ENABLE_IMAGE_PROCESSING=true   # Requires GEMINI_API_KEY or CLAUDE_API_KEY
ENABLE_AUDIO_TRANSCRIPTION=true  # Requires GEMINI_API_KEY (gemini-1.5-flash)
ENABLE_PDF_PROCESSING=true       # Requires pdf-parse library (já instalado)
ENABLE_WHATSAPP=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_STRIPE_BILLING=true

# ===== DEBUG =====
DEBUG=false
VERBOSE_LOGGING=false
